# 伺服器 Port
PORT=3000

# Firebase Admin SDK 服務帳戶金鑰 JSON 檔路徑
# 到 Firebase Console > 專案設定 > 服務帳戶 > 產生新的私密金鑰
# 下載後改名為 serviceAccountKey.json 放到專案根目錄
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Firebase 專案 ID (與 serviceAccountKey.json 內的 project_id 相同)
FIREBASE_PROJECT_ID=database-test-2459b
